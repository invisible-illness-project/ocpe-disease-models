{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocpe-disease-models/schemas/validation_registry.schema.json",
  "title": "Validation Test Registry",
  "description": "Scientific validation tests for model components. File: validation/validation_registry.yaml, top-level key: validation_tests.",
  "type": "object",
  "required": ["validation_tests"],
  "additionalProperties": true,
  "properties": {
    "validation_tests": {
      "type": "array",
      "items": { "$ref": "#/$defs/validation_test" }
    }
  },
  "$defs": {
    "validation_test": {
      "type": "object",
      "required": ["id", "expected_behavior", "acceptance_criteria", "justification"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^VAL-[A-Za-z0-9_.-]+$",
          "description": "Stable validation test identifier."
        },
        "name": { "type": "string" },
        "mechanisms": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^MEC-[A-Za-z0-9_.-]+$"
          },
          "description": "Mechanisms exercised by this test."
        },
        "expected_behavior": {
          "type": "string",
          "minLength": 1,
          "description": "Qualitative or quantitative behavior the model must exhibit."
        },
        "acceptance_criteria": {
          "description": "Objective pass/fail criteria.",
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "minItems": 1, "items": { "type": "string" } }
          ]
        },
        "justification": {
          "type": "string",
          "minLength": 1,
          "description": "Scientific justification: why this test is meaningful."
        },
        "test_path": { "type": "string" }
      }
    }
  }
}
