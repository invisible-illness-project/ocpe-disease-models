{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocpe-disease-models/schemas/evidence_registry.schema.json",
  "title": "Evidence Claims Registry",
  "description": "Atomic evidence claims extracted from the literature. File: evidence_registry.yaml, top-level key: evidence_claims.",
  "type": "object",
  "required": ["evidence_claims"],
  "additionalProperties": true,
  "properties": {
    "evidence_claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": ["id", "statement", "references"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CLM-[A-Za-z0-9_.-]+$",
          "description": "Stable claim identifier."
        },
        "statement": { "type": "string", "minLength": 1 },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^REF-[A-Za-z0-9_.-]+$"
          },
          "description": "Literature references supporting this claim."
        },
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "diseases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
