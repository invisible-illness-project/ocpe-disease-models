diff --git a/validation/validation_registry.yaml b/validation/validation_registry.yaml
new file mode 100644
index 0000000..64518ea
--- /dev/null
+++ b/validation/validation_registry.yaml
@@ -0,0 +1,860 @@
+schema_version: '1.0'
+validation_policy:
+  independence: Each layer is reported separately; a pass in one layer cannot substitute for another.
+  clinical_status: No layer establishes clinical validity, diagnostic accuracy, treatment efficacy, or patient-specific calibration.
+  empirical_comparisons: Group-level literature anchors are heterogeneous plausibility checks, not fitted individual data
+    or prospective external validation.
+  required_test_behavior: Missing required tests, registry entries, references, or outputs are failures and must not be hidden
+    by skips.
+validation_tests:
+- id: VAL-SW-CONFIG
+  name: Configuration and phenotype composition
+  layer: software
+  expected_behavior: YAML configurations load deterministically; unknown parameters, invalid protocols, and conflicting comorbidity
+    overrides fail explicitly.
+  acceptance_criteria: All healthy and disease configurations round-trip without silent changes; conflicting parameter values
+    raise ValueError; mixed non-conflicting mechanisms compose deterministically.
+  justification: Prevents silent parameter override ordering and unrecorded configuration drift.
+  test_path: tests/unit/test_configuration.py
+  evidence_claims: []
+  equation_ids: []
+  parameter_ids: []
+  validation_result:
+    status: REGISTERED_NOT_YET_EXECUTED
+    report: validation/reports/validation-report.json
+  execution_environment:
+    python: '>=3.11'
+    solver: DOP853 where applicable
+    dependency_versions: validation/reproducibility.json
+  last_validated_commit: null
+- id: VAL-SW-SERIALIZATION
+  name: Serialization and numerical failure behavior
+  layer: software
+  expected_behavior: Small traces and metadata serialize reproducibly; non-finite or failed solver output cannot be reported
+    as success.
+  acceptance_criteria: Saved parameters/protocol/configuration hash match the in-memory run; required metadata and arrays
+    are present; invalid parameter domains raise explicit errors.
+  justification: Execution integrity is necessary but is not physiological or clinical validation.
+  test_path: tests/unit/test_serialization.py
+  evidence_claims: []
+  equation_ids: []
+  parameter_ids: []
+  validation_result:
+    status: REGISTERED_NOT_YET_EXECUTED
+    report: validation/reports/validation-report.json
+  execution_environment:
+    python: '>=3.11'
+    solver: DOP853 where applicable
+    dependency_versions: validation/reproducibility.json
+  last_validated_commit: null
+- id: VAL-SW-OCPE
+  name: Strict OCPE package and observation interoperability
+  layer: software
+  expected_behavior: The disease package passes strict OCPE validation and simulated observations preserve declared units
+    and evidence references.
+  acceptance_criteria: Zero strict OCPE errors and warnings; mapped observations validate; cardiac output is mapped from cardiac_output_l_min
+    in L/min.
+  justification: Tests semantic interoperability and unit safety rather than numerical correctness.
+  test_path: tests/unit/test_ocpe_adapter.py; tests/unit/test_observation_mapping.py
+  evidence_claims: []
+  equation_ids: []
+  parameter_ids: []
+  validation_result:
+    status: REGISTERED_NOT_YET_EXECUTED
+    report: validation/reports/validation-report.json
+  execution_environment:
+    python: '>=3.11'
+    solver: DOP853 where applicable
+    dependency_versions: validation/reproducibility.json
+  last_validated_commit: null
+- id: VAL-MATH-CONSERVATION
+  name: Stressed-volume conservation
+  layer: mathematical
+  mechanisms:
+  - MEC-CV-VOLUME
+  expected_behavior: The sum of arterial, central-venous, and peripheral-venous stressed volumes remains invariant.
+  acceptance_criteria: Maximum absolute volume drift is below 1e-6 mL over baseline and orthostatic runs; instantaneous RHS
+    volume derivatives sum to zero within floating-point tolerance.
+  justification: The compartment equations imply exact conservation; drift would reveal an implementation or solver error.
+  test_path: tests/mathematical/test_conservation.py
+  evidence_claims:
+  - CLM-CV-HEMODYNAMICS
+  equation_ids:
+  - EQ-CV-001
+  - EQ-CV-002
+  - EQ-CV-003
+  - EQ-CV-004
+  - EQ-CV-005
+  parameter_ids:
+  - PAR-ARTERIAL-COMPLIANCE
+  - PAR-CENTRAL-VENOUS-COMPLIANCE
+  - PAR-PERIPHERAL-VENOUS-COMPLIANCE
+  - PAR-SYSTEMIC-RESISTANCE
+  - PAR-VENOUS-RETURN-RESISTANCE
+  - PAR-ARTERIAL-VOLUME-INITIAL
+  - PAR-CENTRAL-VENOUS-VOLUME-INITIAL
+  - PAR-PERIPHERAL-VENOUS-VOLUME-INITIAL
+  validation_result:
+    status: REGISTERED_NOT_YET_EXECUTED
+    report: validation/reports/validation-report.json
+  execution_environment:
+    python: '>=3.11'
+    solver: DOP853 where applicable
+    dependency_versions: validation/reproducibility.json
+  last_validated_commit: null
+- id: VAL-MATH-CONVERGENCE
+  name: Solver convergence and bounded states
+  layer: mathematical
+  mechanisms:
+  - MEC-CV-VOLUME
+  - MEC-AUT-BAROREFLEX
+  expected_behavior: Solutions converge under tighter tolerances and remain finite in all demonstrated protocols.
+  acceptance_criteria: Tightening rtol/atol and max_step changes key summary metrics by less than 0.1 bpm, 0.1 mmHg, or 0.001
+    normalized units; all states and outputs are finite.
+  justification: Detects numerical artifacts without claiming that numerical convergence establishes model truth.
+  test_path: tests/mathematical/test_convergence.py
+  evidence_claims:
+  - CLM-CV-HEMODYNAMICS
+  - CLM-POTS-BAROREFLEX
+  - CLM-POTS-CRITERIA
+  - CLM-LC-HETEROGENEITY
+  equation_ids:
+  - EQ-CV-001
+  - EQ-CV-002
+  - EQ-CV-003
+  - EQ-CV-004
+  - EQ-CV-005
+  - EQ-AUT-001
+  - EQ-AUT-002
+  - EQ-AUT-003
+  parameter_ids:
+  - PAR-ARTERIAL-COMPLIANCE
+  - PAR-CENTRAL-VENOUS-COMPLIANCE
+  - PAR-PERIPHERAL-VENOUS-COMPLIANCE
+  - PAR-SYSTEMIC-RESISTANCE
+  - PAR-VENOUS-RETURN-RESISTANCE
+  - PAR-ARTERIAL-VOLUME-INITIAL
+  - PAR-CENTRAL-VENOUS-VOLUME-INITIAL
+  - PAR-PERIPHERAL-VENOUS-VOLUME-INITIAL
+  - PAR-BAROREFLEX-PRESSURE-SETPOINT
+  - PAR-BAROREFLEX-PRESSURE-SCALE
+  - PAR-SYMPATHETIC-TIME-CONSTANT
+  - PAR-HEART-RATE-BASE
+  - PAR-HEART-RATE-SYMPATHETIC-GAIN
+  validation_result:
+    status: REGISTERED_NOT_YET_EXECUTED
+    report: validation/reports/validation-report.json
+  execution_environment:
+    python: '>=3.11'
+    solver: DOP853 where applicable
+    dependency_versions: validation/reproducibility.json
+  last_validated_commit: null
+- id: VAL-PHYS-BASELINE
+  name: Healthy resting operating point
+  layer: physiological
+  mechanisms:
+  - MEC-CV-VOLUME
