+    path.mkdir(parents=True)
+    (path / "references.yaml").write_text(":\n  - [unclosed\n", encoding="utf-8")
+    result = run_audit(tmp_path, deterministic=True)
+    assert any(f.check == "registry-load-error" for f in errors(result))
